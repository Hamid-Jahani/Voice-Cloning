# ---------------------------------------------------------------------------
# Line endings
# ---------------------------------------------------------------------------
# Force LF for source regardless of a contributor's core.autocrlf setting, so
# the repository never accumulates mixed endings.
*.py     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# ---------------------------------------------------------------------------
# Binary artefacts
# ---------------------------------------------------------------------------
# Never diff, never line-ending-convert. Model weights and generated audio are
# gitignored, but declaring them here protects anyone who force-adds one.
*.npz    binary
*.wav    binary
*.flac   binary
*.mp3    binary
*.ogg    binary
*.pt     binary
*.pth    binary
*.tar    binary
*.ckpt   binary
