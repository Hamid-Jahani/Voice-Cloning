# ---------------------------------------------------------------------------
# Language statistics
# ---------------------------------------------------------------------------
# GitHub's Linguist weighs languages by byte count. The preserved Colab
# notebook is ~2.6 MB (almost entirely embedded audio output) against ~44 KB of
# Python, so without this the repository reports as "Jupyter Notebook" despite
# the source being a Python package. Marking it as documentation excludes it
# from the statistics while keeping it browsable and rendered on GitHub.
notebooks/**   linguist-documentation
*.ipynb        linguist-documentation

# ---------------------------------------------------------------------------
# Line endings
# ---------------------------------------------------------------------------
# Force LF for source regardless of a contributor's core.autocrlf setting, so
# the repository never accumulates mixed endings. These files are already LF,
# so this pins current behaviour rather than rewriting anything.
*.py     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Notebooks are JSON and git may normalise them, but the checked-in copy
# predates this file; left at the default to avoid a 2.6 MB whitespace diff.
*.ipynb  text

# ---------------------------------------------------------------------------
# Binary artefacts
# ---------------------------------------------------------------------------
# Never diff, never line-ending-convert. Model weights and generated audio are
# gitignored, but declaring them here protects anyone who force-adds one.
*.npz    binary
*.wav    binary
*.flac   binary
*.mp3    binary
*.ogg    binary
*.pt     binary
*.pth    binary
*.tar    binary
*.ckpt   binary
